{
    "manifest_version": 3,
    "name": "DocsKeys",
    "description": "Vim-style keyboard shortcuts for Google Docs",
    "version": "1.6.0",
    "icons": {
        "32": "icons/32.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "icons/32.png"
    },
    "permissions": [
        "clipboardRead",
        "clipboardWrite",
        "storage"
    ],
    "content_scripts": [
        {
            "js": [
                "settings.js",
                "content.js"
            ],
            "matches": [
                "https://docs.google.com/document/*"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "page_script.js"
            ],
            "matches": [
                "https://docs.google.com/*"
            ]
        }
    ]
}
