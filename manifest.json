{
    "manifest_version": 3,
    "name": "DocsKeys",
    "description": "Vim-style keyboard shortcuts for Google Docs",
    "version": "1.12.0",
    "icons": {
        "32": "icons/32.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "icons/32.png"
    },
    "permissions": [
        "clipboardRead",
        "clipboardWrite",
        "storage"
    ],
    "content_scripts": [
        {
            "js": ["page_script.js"],
            "world": "MAIN",
            "run_at": "document_start",
            "matches": ["https://docs.google.com/document/*"]
        },
        {
            "js": ["annotation_bootstrap.js"],
            "run_at": "document_start",
            "matches": ["https://docs.google.com/document/*"]
        },
        {
            "js": [
                "settings.js",
                "vim.js",
                "read_ui.js",
                "rendered_reader.js",
                "text_model.js",
                "search.js",
                "g_prefix.js",
                "viewport.js",
                "linewise.js",
                "content.js"
            ],
            "matches": [
                "https://docs.google.com/document/*"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "page_script.js",
                "annotate.js"
            ],
            "matches": [
                "https://docs.google.com/*"
            ]
        }
    ]
}
